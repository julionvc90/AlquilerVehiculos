<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- =========================================================== -->
    <!-- Persistencia de logs del microservicio Usuario              -->
    <!-- =========================================================== -->

    <!-- Salida a consola (desarrollo) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Persistencia a archivo -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/usuario.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Rotación diaria con %d, máximo 10 MB por archivo -->
            <fileNamePattern>logs/usuario-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <!-- Conservar 30 días de logs -->
            <maxHistory>30</maxHistory>
            <!-- Máximo 500 MB totales entre todos los archivos -->
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Niveles de log por paquete -->
    <logger name="com.example.usuario" level="INFO" />
    <logger name="org.springframework" level="WARN" />
    <logger name="org.hibernate" level="WARN" />

    <!-- Raíz: INFO → consola + archivo -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
